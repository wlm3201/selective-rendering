{
	"schemaVersion": 1,
	"id": "selective_rendering",
	"version": "${version}",
	"name": "Selective Rendering",
	"description": "Selective block rendering: hold a breeze rod, then scroll to switch mode and transparency, and click blocks to build the list.\nPorted from the selective rendering feature of Lucidity by ryan100c.",
	"authors": [
		"ryan100c (original author)",
		"wlm3201 (porter)"
	],
	"license": "CC-BY-NC-4.0",
	"icon": "assets/selective_rendering/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.selectiverendering.SelectiveRendering"
		],
		"modmenu": [
			"com.selectiverendering.config.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "selective-rendering.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"java": ">=25",
		"minecraft": "${minecraft_dependency}",
		"malilib": "${malilib_dependency}"
	}
}
