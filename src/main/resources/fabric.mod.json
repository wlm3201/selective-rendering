{
	"schemaVersion": 1,
	"id": "selectiverendering",
	"version": "${version}",
	"name": "Selective Rendering",
	"description": "Makes any block translucent or hides it entirely, driven by a region plus a block list.",
	"authors": ["ryan100c (original author)", "wlm3201 (porter)"],
	"contact": {
		"sources": "https://github.com/wlm3201/selective-rendering"
	},
	"license": "CC-BY-NC-4.0",
	"icon": "assets/selectiverendering/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.selectiverendering.client.SelectiveRendering"],
		"modmenu": ["com.selectiverendering.client.config.ModMenuIntegration"]
	},
	"mixins": [
		{
			"config": "selectiverendering.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"java": ">=25",
		"minecraft": "${minecraft_dependency}",
		"malilib": "${malilib_dependency}"
	},
	"suggests": {
		"fabric-api": "*",
		"modmenu": "*"
	}
}
